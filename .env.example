# Copy to .env. Never commit .env.

# --- service ---
APP_ENV=dev
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
# Allows `debug=true` on /v1/identify to return the transcript. Keep false in production.
ALLOW_DEBUG=false
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=20

# --- stores (docker compose overrides these two for the backend container) ---
DATABASE_URL=postgresql+asyncpg://ansit:ansit@localhost:5432/ansit
REDIS_URL=redis://localhost:6379/0

# --- docker compose (dev defaults; change for anything non-local) ---
POSTGRES_USER=ansit
POSTGRES_PASSWORD=ansit
POSTGRES_DB=ansit

# --- matching: PLACEHOLDERS, calibrated in Phase 1 (text) and Phase 3 (reciter) ---
MATCH_THRESHOLD=70
AMBIGUITY_DELTA=2
RECITER_THRESHOLD=0.5

# --- audio limits ---
MIN_SPEECH_SEC=1.5
MIN_CLIP_SEC=3
MAX_CLIP_SEC=15
MAX_UPLOAD_MB=2

# --- models ---
ASR_MODEL_PATH=
ASR_BEAM_SIZE=5
# cpu | cuda (GPU is optional)
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
CPU_THREADS_ASR=2
CPU_THREADS_SPEAKER=2
