# Copy to .env. Never commit .env.

# --- service ---
APP_ENV=dev
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
# Allows `debug=true` on /v1/identify to return the transcript. Keep false in production.
ALLOW_DEBUG=false
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=20

# --- stores (docker compose overrides these two for the backend container) ---
DATABASE_URL=postgresql+asyncpg://ansit:ansit@localhost:5432/ansit
REDIS_URL=redis://localhost:6379/0

# --- docker compose (dev defaults; change for anything non-local) ---
POSTGRES_USER=ansit
POSTGRES_PASSWORD=ansit
POSTGRES_DB=ansit

# --- matching ---
# 0-100. Provisional: calibrated on text in Phase 1, re-calibrated on audio in Phase 2.
MATCH_THRESHOLD=76
AMBIGUITY_DELTA=2
# Placeholder until Phase 3.
RECITER_THRESHOLD=0.5

# --- audio limits ---
MIN_SPEECH_SEC=1.5
MIN_CLIP_SEC=3
MAX_CLIP_SEC=15
MAX_UPLOAD_MB=2

# --- models ---
# A CTranslate2 model directory, e.g. ../ml/artifacts/asr/tarteel-base
ASR_MODEL_PATH=
ASR_BEAM_SIZE=5
# cpu | cuda (GPU is optional)
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
CPU_THREADS_ASR=2
CPU_THREADS_SPEAKER=2

# --- speech detection and hallucination guards ---
# Low on purpose: the speech detector under-detects recitation.
VAD_THRESHOLD=0.15
VAD_TRIM_SILENCE=false
ASR_MAX_NO_SPEECH_PROB=0.6
ASR_MIN_AVG_LOGPROB=-1.0
ASR_MAX_COMPRESSION_RATIO=2.4

# --- artifacts ---
QURAN_INDEX_PATH=../ml/artifacts/quran_index.json.gz
